# Server Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# CORS & Client Origins
CLIENT_ORIGIN=http://localhost:5173,http://localhost

# Database Configuration (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority&appName=DayDawn01

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
