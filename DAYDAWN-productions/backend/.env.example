# Server Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# CORS & Client Origins (Comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5173,http://localhost

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://daydawn_user:daydawn_secure_password@localhost:5432/daydawn_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=daydawn_user
DB_PASSWORD=daydawn_secure_password
DB_NAME=daydawn_db

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
